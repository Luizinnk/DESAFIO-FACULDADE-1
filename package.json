{
  "name": "agendauni",
  "private": true,
  "description": "Atalhos para rodar o AgendaUNI (backend Spring Boot + frontend React/Vite)",
  "scripts": {
    "api": "cd backend && ./mvnw spring-boot:run",
    "api:reset": "cd backend && ./mvnw spring-boot:run -Dspring-boot.run.arguments=--app.reset-dados=true",
    "web": "npm --prefix frontend run dev",
    "instalar": "npm --prefix frontend install"
  }
}
