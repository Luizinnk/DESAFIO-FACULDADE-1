<%- include('partials/topo') %>
<div class="titulo-linha">
  <h1>Minhas solicitações</h1>
  <a href="/solicitacoes/nova" class="botao">Nova solicitação</a>
</div>

<% if (!eventos.length) { %>
  <p class="vazio">Você ainda não tem solicitações.</p>
<% } else { %>
<div class="tabela-scroll">
<table>
  <thead><tr><th>Evento</th><th>Quando</th><th>Status</th></tr></thead>
  <tbody>
  <% for (const e of eventos) { %>
    <tr>
      <td><a href="/solicitacoes/<%= e.id %>"><%= e.nome %></a><span class="secundario-texto"><%= e.local || 'Local não definido' %></span></td>
      <td class="nowrap"><%= dataBR(e.data) %><span class="secundario-texto"><%= e.hora_inicio || '—' %> – <%= e.hora_fim || '—' %></span></td>
      <td><span class="status <%= e.status %>"><%= STATUS_TEXTO[e.status] %></span></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
<% } %>
<%- include('partials/rodape') %>
