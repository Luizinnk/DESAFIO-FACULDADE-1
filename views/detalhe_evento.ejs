<%- include('partials/topo') %>
<% const sn = (x) => x === 1 ? 'Sim' : x === 0 ? 'Não' : '—'; %>
<div class="titulo-linha">
  <h1><%= ev.nome %></h1>
  <span class="status <%= ev.status %>"><%= STATUS_TEXTO[ev.status] %></span>
</div>

<% if (ev.status === 'REJEITADO' && ev.motivo_rejeicao) { %>
  <div class="aviso erro"><strong>Motivo da rejeição:</strong> <%= ev.motivo_rejeicao %></div>
<% } %>
<% if (typeof conflito !== 'undefined' && conflito) { %>
  <div class="aviso erro">Atenção: conflita com o evento aprovado "<%= conflito.nome %>"
    (<%= conflito.hora_inicio %>–<%= conflito.hora_fim %>). A aprovação será bloqueada.</div>
<% } %>

<div class="cartao">
  <dl class="detalhes">
    <dt>Data</dt><dd><%= dataBR(ev.data) %></dd>
    <dt>Horário</dt><dd><%= ev.hora_inicio || '—' %> – <%= ev.hora_fim || '—' %></dd>
    <dt>Tema</dt><dd><%= ev.tema || '—' %></dd>
    <dt>Local</dt><dd><%= ev.local || '—' %></dd>
    <dt>Curso / coordenação</dt><dd><%= ev.curso || '—' %></dd>
    <dt>Centro de custo</dt><dd><%= ev.centro_custo || '—' %></dd>
    <dt>Solicitante (informado)</dt><dd><%= ev.solicitante || '—' %></dd>
    <dt>Registrado por (usuário)</dt><dd><%= ev.autor %></dd>
    <dt>Palestrante</dt><dd><%= ev.palestrante || '—' %></dd>
    <dt>Público-alvo</dt><dd><%= ev.publico_alvo || '—' %></dd>
    <dt>Justificativa</dt><dd><%= ev.justificativa || '—' %></dd>
    <dt>Objetivo</dt><dd><%= ev.objetivo || '—' %></dd>
    <dt>Cerimonial</dt><dd><%= sn(ev.cerimonial) %></dd>
    <dt>Haverá inscrições</dt><dd><%= sn(ev.inscricoes) %></dd>
    <dt>Declarações</dt><dd><%= sn(ev.declaracoes) %></dd>
    <dt>Recursos</dt><dd><%= ev.recursos_nomes.join(', ') || '—' %></dd>
    <dt>Observações</dt><dd><%= ev.observacoes || '—' %></dd>
    <dt>Última alteração</dt><dd><%= ev.atualizado_em %></dd>
  </dl>
</div>

<div class="acoes">
<% if (modo === 'solicitante') { %>
  <% if (EDITAVEIS.includes(ev.status)) { %>
    <a href="/solicitacoes/<%= ev.id %>/editar" class="botao"><%= ev.status === 'REJEITADO' ? 'Corrigir e reenviar' : 'Editar' %></a>
  <% } %>
  <% if (ev.status === 'RASCUNHO') { %>
    <form method="post" action="/solicitacoes/<%= ev.id %>/excluir" onsubmit="return confirm('Excluir este rascunho?')">
      <button class="botao perigo">Excluir rascunho</button>
    </form>
  <% } %>
  <% if (ev.status === 'AGUARDANDO') { %>
    <form method="post" action="/solicitacoes/<%= ev.id %>/cancelar" onsubmit="return confirm('Cancelar esta solicitação?')">
      <button class="botao perigo">Cancelar solicitação</button>
    </form>
  <% } %>
  <a href="/minhas" class="link">Voltar</a>
<% } else { %>
  <% if (ev.status === 'AGUARDANDO') { %>
    <form method="post" action="/admin/solicitacoes/<%= ev.id %>/aprovar">
      <button class="botao sucesso">Aprovar e publicar</button>
    </form>
    <form method="post" action="/admin/solicitacoes/<%= ev.id %>/rejeitar" class="rejeitar">
      <input name="motivo" placeholder="Justificativa da rejeição (obrigatória)">
      <button class="botao perigo">Rejeitar</button>
    </form>
  <% } %>
  <% if (ev.status === 'APROVADO') { %>
    <a href="/admin/solicitacoes/<%= ev.id %>/editar" class="botao">Editar evento</a>
    <form method="post" action="/admin/solicitacoes/<%= ev.id %>/cancelar" onsubmit="return confirm('Cancelar este evento aprovado?')">
      <button class="botao perigo">Cancelar evento</button>
    </form>
  <% } %>
  <a href="/admin/solicitacoes?status=<%= ev.status %>" class="link">Voltar</a>
<% } %>
</div>
<%- include('partials/rodape') %>
