<%- include('partials/topo') %>
<% const sn = (x) => x === 1 ? 'Sim' : x === 0 ? 'Não' : '—'; %>
<div class="titulo-linha">
  <h1><%= ev.nome %></h1>
  <span class="status <%= ev.status %>"><%= STATUS_TEXTO[ev.status] %></span>
</div>
<div class="resumo">
  <span><strong><%= dataBR(ev.data) %></strong></span>
  <span><strong><%= ev.hora_inicio || '—' %> – <%= ev.hora_fim || '—' %></strong></span>
  <span><%= ev.local || 'Local não definido' %></span>
  <span><%= ev.tema || 'Sem tema' %></span>
</div>

<% if (ev.status === 'REJEITADO' && ev.motivo_rejeicao) { %>
  <div class="aviso erro"><strong>Motivo da rejeição:</strong> <%= ev.motivo_rejeicao %></div>
<% } %>
<% if (typeof conflito !== 'undefined' && conflito) { %>
  <div class="aviso erro">Conflita com o evento aprovado "<%= conflito.nome %>"
    (<%= conflito.hora_inicio %>–<%= conflito.hora_fim %>). A aprovação será bloqueada.</div>
<% } %>

<div class="cartao">
  <section class="secao">
    <h2>Responsáveis</h2>
    <dl class="blocos">
      <div><dt>Solicitante</dt><dd><%= ev.solicitante || '—' %></dd></div>
      <div><dt>Palestrante</dt><dd><%= ev.palestrante || '—' %></dd></div>
      <div><dt>Curso / coordenação</dt><dd><%= ev.curso || '—' %></dd></div>
      <div><dt>Centro de custo</dt><dd><%= ev.centro_custo || '—' %></dd></div>
    </dl>
  </section>
  <section class="secao">
    <h2>Detalhes</h2>
    <dl class="blocos">
      <div class="largo"><dt>Público-alvo</dt><dd><%= ev.publico_alvo || '—' %></dd></div>
      <div class="largo"><dt>Justificativa</dt><dd><%= ev.justificativa || '—' %></dd></div>
      <div class="largo"><dt>Objetivo</dt><dd><%= ev.objetivo || '—' %></dd></div>
      <div><dt>Cerimonial</dt><dd><%= sn(ev.cerimonial) %></dd></div>
      <div><dt>Inscrições</dt><dd><%= sn(ev.inscricoes) %></dd></div>
      <div><dt>Declarações</dt><dd><%= sn(ev.declaracoes) %></dd></div>
      <div><dt>Recursos</dt><dd><%= ev.recursos_nomes.join(', ') || '—' %></dd></div>
      <% if (ev.observacoes) { %><div class="largo"><dt>Observações</dt><dd><%= ev.observacoes %></dd></div><% } %>
    </dl>
  </section>
  <p class="dica" style="margin:0">Registrado por <%= ev.autor %> · última alteração em <%= ev.atualizado_em %></p>
</div>

<div class="acoes">
<% if (modo === 'solicitante') { %>
  <a href="/minhas" class="link">Voltar</a>
  <span class="direita"></span>
  <% if (ev.status === 'RASCUNHO') { %>
    <form method="post" action="/solicitacoes/<%= ev.id %>/excluir" onsubmit="return confirm('Excluir este rascunho?')">
      <button class="botao perigo">Excluir</button>
    </form>
  <% } %>
  <% if (ev.status === 'AGUARDANDO') { %>
    <form method="post" action="/solicitacoes/<%= ev.id %>/cancelar" onsubmit="return confirm('Cancelar esta solicitação?')">
      <button class="botao perigo">Cancelar solicitação</button>
    </form>
  <% } %>
  <% if (EDITAVEIS.includes(ev.status)) { %>
    <a href="/solicitacoes/<%= ev.id %>/editar" class="botao"><%= ev.status === 'REJEITADO' ? 'Corrigir e reenviar' : 'Editar' %></a>
  <% } %>
<% } else { %>
  <a href="/admin/solicitacoes?status=<%= ev.status %>" class="link">Voltar</a>
  <% if (ev.status === 'AGUARDANDO') { %>
    <form method="post" action="/admin/solicitacoes/<%= ev.id %>/rejeitar" class="rejeitar direita">
      <input name="motivo" placeholder="Motivo da rejeição">
      <button class="botao perigo">Rejeitar</button>
    </form>
    <form method="post" action="/admin/solicitacoes/<%= ev.id %>/aprovar">
      <button class="botao sucesso">Aprovar</button>
    </form>
  <% } %>
  <% if (ev.status === 'APROVADO') { %>
    <form method="post" action="/admin/solicitacoes/<%= ev.id %>/cancelar" class="direita" onsubmit="return confirm('Cancelar este evento aprovado?')">
      <button class="botao perigo">Cancelar evento</button>
    </form>
    <a href="/admin/solicitacoes/<%= ev.id %>/editar" class="botao">Editar</a>
  <% } %>
<% } %>
</div>
<%- include('partials/rodape') %>
