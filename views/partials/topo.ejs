<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AgendaUni — Eventos Institucionais</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<% const at = (p) => (p === '/' ? caminho === '/' : caminho.startsWith(p)) ? 'ativo' : ''; %>
<header class="topo">
  <div class="topo-conteudo">
    <a href="/" class="marca">AgendaUni</a>
    <nav class="menu">
      <a href="/" class="<%= at('/') %>">Agenda</a>
      <% if (usuario && usuario.perfil === 'ADMIN') { %>
        <a href="/admin/solicitacoes" class="<%= at('/admin/solicitacoes') %>">Solicitações</a>
        <a href="/admin/cadastros" class="<%= at('/admin/cadastros') %>">Cadastros</a>
        <a href="/admin/usuarios" class="<%= at('/admin/usuarios') %>">Usuários</a>
        <a href="/admin/relatorio" class="<%= at('/admin/relatorio') %>">Relatório</a>
      <% } else if (usuario) { %>
        <a href="/minhas" class="<%= at('/minhas') || at('/solicitacoes') %>">Minhas solicitações</a>
      <% } %>
    </nav>
    <div class="conta">
      <% if (usuario) { %>
        <span class="quem"><%= usuario.nome %></span>
        <form method="post" action="/logout" class="inline"><button class="link">Sair</button></form>
      <% } else { %>
        <a href="/login" class="botao">Entrar</a>
      <% } %>
    </div>
  </div>
</header>
<main>
<% if (flash) { %>
  <div class="aviso <%= flash.tipo %>"><%= flash.texto %></div>
<% } %>
