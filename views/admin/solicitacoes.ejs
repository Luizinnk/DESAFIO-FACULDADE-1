<%- include('../partials/topo') %>
<h1>Analisar solicitações</h1>
<nav class="abas">
  <% for (const s of STATUS) { %>
    <a href="?status=<%= s %>" class="<%= s === status ? 'ativo' : '' %>"><%= STATUS_TEXTO[s] %></a>
  <% } %>
</nav>

<% if (!eventos.length) { %>
  <p class="vazio">Nenhuma solicitação com status "<%= STATUS_TEXTO[status] %>".</p>
<% } else { %>
<div class="tabela-scroll">
<table>
  <thead><tr><th>#</th><th>Evento</th><th>Data</th><th>Horário</th><th>Local</th><th>Solicitante</th><th></th></tr></thead>
  <tbody>
  <% for (const e of eventos) { %>
    <tr>
      <td><%= e.id %></td>
      <td><%= e.nome %></td>
      <td class="nowrap"><%= dataBR(e.data) %></td>
      <td class="nowrap"><%= e.hora_inicio %> – <%= e.hora_fim %></td>
      <td><%= e.local %></td>
      <td><%= e.solicitante %></td>
      <td><a href="/admin/solicitacoes/<%= e.id %>">Abrir</a></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
<% } %>
<%- include('../partials/rodape') %>
