<%- include('../partials/topo') %>
<h1>Solicitações</h1>
<nav class="abas">
  <% for (const s of STATUS) { %>
    <a href="?status=<%= s %>" class="<%= s === status ? 'ativo' : '' %>"><%= STATUS_TEXTO[s] %></a>
  <% } %>
</nav>

<% if (!eventos.length) { %>
  <p class="vazio">Nenhuma solicitação com status "<%= STATUS_TEXTO[status] %>".</p>
<% } else { %>
<div class="tabela-scroll">
<table>
  <thead><tr><th>Evento</th><th>Quando</th><th>Solicitante</th></tr></thead>
  <tbody>
  <% for (const e of eventos) { %>
    <tr>
      <td><a href="/admin/solicitacoes/<%= e.id %>"><%= e.nome %></a><span class="secundario-texto"><%= e.local %></span></td>
      <td class="nowrap"><%= dataBR(e.data) %><span class="secundario-texto"><%= e.hora_inicio %> – <%= e.hora_fim %></span></td>
      <td><%= e.solicitante %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
<% } %>
<%- include('../partials/rodape') %>
