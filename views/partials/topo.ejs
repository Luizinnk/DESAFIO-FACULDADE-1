<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AgendaUni — Eventos Institucionais</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topo">
  <a href="/" class="marca">AgendaUni <small>Eventos Institucionais</small></a>
  <nav>
    <a href="/" class="<%= caminho === '/' ? 'ativo' : '' %>">Agenda pública</a>
    <% if (usuario) { %>
      <a href="/minhas" class="<%= caminho.startsWith('/minhas') || caminho.startsWith('/solicitacoes') ? 'ativo' : '' %>">Minhas solicitações</a>
      <% if (usuario.perfil === 'ADMIN') { %>
        <% const at = (p) => caminho.startsWith(p) ? 'ativo' : ''; %>
        <a href="/admin/solicitacoes" class="<%= at('/admin/solicitacoes') %>">Analisar</a>
        <a href="/admin/cadastros/temas" class="<%= at('/admin/cadastros') %>">Cadastros</a>
        <a href="/admin/usuarios" class="<%= at('/admin/usuarios') %>">Usuários</a>
        <a href="/admin/relatorio" class="<%= at('/admin/relatorio') %>">Relatório</a>
      <% } %>
      <form method="post" action="/logout" class="inline">
        <span class="quem"><%= usuario.nome %> (<%= usuario.perfil === 'ADMIN' ? 'Admin' : 'Solicitante' %>)</span>
        <button class="link">Sair</button>
      </form>
    <% } else { %>
      <a href="/login" class="botao">Entrar</a>
    <% } %>
  </nav>
</header>
<main>
<% if (flash) { %>
  <div class="aviso <%= flash.tipo %>"><%= flash.texto %></div>
<% } %>
